# Copier en terraform.tfvars (ou envs/<env>.tfvars) et adapter.
subscription_id = "00000000-0000-0000-0000-000000000000"
project         = "pseudo"
environment     = "dev"
location        = "francecentral"
openai_location = "swedencentral"

# Resource group : null = rg-<project>-<environment>. create_resource_group = false s'il existe déjà.
resource_group_name   = null
create_resource_group = true

# Storage d'origine (où arrivent les documents). null = container d'entrée du compte « data » créé ici.
# Sinon, compte EXISTANT (autre resource group ou abonnement possible) :
# source_storage_account_id = "/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<nom>"
source_storage_account_id = null
source_container_name     = "incoming"
create_source_container   = false # compte existant : créer le container s'il n'existe pas
source_system_topic_name  = null  # compte existant ayant déjà un topic Event Grid : son nom

# Modèle utilisé par les agents de détection et de vérification
openai_model_name       = "gpt-5-mini"
openai_model_version    = "2025-08-07"
openai_deployment_sku   = "DataZoneStandard"
openai_capacity         = 100
openai_reasoning_effort = "low"

# Document publié : valeurs fictives réalistes ("substitution") ou jetons ("jetons")
pseudo_output_mode = "substitution"
handwriting_policy = "quarantaine" # ou "traiter"

enable_language_pii       = true
enable_private_networking = false
allowed_ip_ranges         = [] # ex. ["203.0.113.10"] : IP du poste/runner de déploiement

function_max_instances      = 2
function_instance_memory_mb = 2048
delete_source_after_success = false
incoming_retention_days      = 7
work_retention_days         = 1
quarantine_retention_days   = 30

# Dossiers de sortie : year=AAAA/month=MM/day=JJ/hour=HH/domain=<type>, d'après la date de dépose
deposit_timezone = "Europe/Paris"

# Mails .eml : un dossier pseudonymisé par mail (corps, en-têtes, pièces jointes)
mail_image_min_side    = 300 # images de mail plus petites sur un côté : retirées (logos, icônes)
enable_mail_processing = true

# JSON de métadonnées de la GED (<nom du document>.json), publiés pseudonymisés avec leur document
enable_json_metadata         = true
json_metadata_retention_days = 7

# Images (photos, scans) : crée l'app images et ajoute les extensions au filtre Event Grid
enable_image_processing      = true
image_function_max_instances = 5
image_function_memory_mb     = 4096
# image_extensions = [".jpg", ".jpeg", ".png", ".heic", ".heif", ".tif", ".tiff", ".webp", ".bmp"]

# Groupe Entra autorisé à ré-identifier les jetons (reidentify.py)
reidentification_principal_ids = []

pipeline_settings = {
  MAX_PAGES           = "200"
  VERIFICATION_ROUNDS = "2"
  OCR_MIN_CONFIDENCE  = "0.75"
  IMAGE_MIN_SHORT_SIDE = "900"
  IMAGE_RENDER_DPI = "200"
  # REPORT_DETAIL  = "standard" # défaut "diagnostic" : rapport détaillé par étape, sans valeurs
}

tags = {
  owner = "equipe-data"
}
